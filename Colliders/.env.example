# COLLIDERS Configuration Example

# Space-Track.org API Credentials (Optional - Mock data fallback provided)
SPACETRACK_USER=your_email@example.com
SPACETRACK_PASS=your_password

# Flask Backend API Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False

# PyTorch Device Selection: auto, cpu, cuda
DEVICE=auto

# Database Path
DATABASE_PATH=data/colliders.db
